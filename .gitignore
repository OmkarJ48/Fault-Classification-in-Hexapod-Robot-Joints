# ---------------------------------------------------------------------------
# Fault Classification in Hexapod Robot Joints — MATLAB project
# ---------------------------------------------------------------------------

# --- MATLAB editor / session artefacts ---
# .asv and .m~ are the editor autosave and backup files
*.asv
*.m~
*.autosave
octave-workspace

# Compiled MEX binaries (platform specific)
*.mex*
*.mexa64
*.mexmaci64
*.mexw32
*.mexw64
*.o
*.obj

# Simulink cache / code generation output
*.slxc
codegen/
slprj/
sccprj/
_sfprj/

# MATLAB Project housekeeping
resources/project/
.SimulinkProject/
helpsearch*/

# --- Trained models & saved session state ---
# Regenerate these by re-running the scripts; do not commit binaries.
*.mat
*.onnx
*.h5
*.pt
*.pkl

# --- Generated figures & exported results ---
# Plots are produced by the scripts; the repo keeps code + source data only.
figures/
results/
output/
*.fig
*.eps
*.svg
*.tif
*.tiff

# NOTE: *.csv and *.docx are intentionally NOT ignored. The datasets in
# original_dataset/ and matlab_codes/**, and the reports in docs/, are
# tracked deliverables of this coursework.

# --- Python (only if the optional analysis virtualenv is used) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*~
.idea/
.vscode/
*.code-workspace

# --- Archives / installers ---
*.zip
*.7z
*.rar
*.tar.gz
